rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isRoomMember(roomId) {
      return exists(
        /databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid)
      );
    }

    function roomDoc(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId));
    }

    function isHost(roomId) {
      return roomDoc(roomId).data.host_player_id == request.auth.uid;
    }

    // A non-host player may only write their own round state, and only in the
    // fields gameplay updates. The imposter's guess must be one of the options
    // revealed to them, so a player cannot submit the secret word directly.
    function isOwnStateUpdate(playerId) {
      return request.auth.uid == playerId
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['reveal_ready', 'discussion_ready', 'submitted_guess', 'updated_at'])
        && (request.resource.data.submitted_guess == null
            || (resource.data.guess_options != null
                && request.resource.data.submitted_guess in resource.data.guess_options));
    }

    // True when the room has anonymous voting enabled. Only the host may then
    // read the individual vote documents, so who voted for whom stays private.
    function anonymousVoting(roomId) {
      let s = roomDoc(roomId).data.settings;
      return s != null && 'anonymous_voting' in s && s.anonymous_voting == true;
    }

    // Collection-group rule.
    //
    // Firestore requires rules that match the full subcollection path pattern
    // (e.g. `{path=**}/players/{player}`) in order to authorize
    // collection-group queries; the explicit matches below (e.g.
    // `rooms/{roomId}/players/{playerId}`) do not. The app runs collection
    // group queries on `players` when locating a user's active room
    // (create-room guard and reconnection), always filtered to the caller's
    // own player_id, so reads are restricted to that user's own player docs.
    // Rules are not filters: the where clause must match the rule for the
    // query to succeed, and any result the caller could read is their own.
    match /{path=**}/players/{playerId} {
      allow read: if isSignedIn()
        && resource.data.player_id == request.auth.uid;
    }

    // Room code uniqueness index. Any signed-in user may read or write it;
    // a room code is only "taken" once the room itself exists.
    match /rooms_by_code/{code} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /rooms/{roomId} {
      // Room reads are limited to host/members plus the lobby itself, so a
      // room can be located by code while joining without exposing playing
      // rooms (names, codes, settings) to arbitrary signed-in users.
      allow read: if isSignedIn()
        && (isHost(roomId) || isRoomMember(roomId)
            || resource.data.status == 'lobby');
      // A user can only create a room as its host, and only in lobby status.
      allow create: if isSignedIn()
        && request.resource.data.host_player_id == request.auth.uid
        && request.resource.data.status == 'lobby';
      // Host may change anything; other room members may only adjust the
      // join count (e.g. when joining or leaving a room).
      allow update: if isSignedIn() && (
        isHost(roomId)
        || request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['player_count', 'updated_at'])
      );
      allow delete: if isSignedIn() && isHost(roomId);

      match /players/{playerId} {
        allow read: if isSignedIn()
          && (isHost(roomId) || isRoomMember(roomId));
        allow create: if isSignedIn() && request.auth.uid == playerId;
        allow update: if isSignedIn() && isRoomMember(roomId)
          && (request.auth.uid == playerId || isHost(roomId));
        allow delete: if isSignedIn()
          && (request.auth.uid == playerId || isHost(roomId));
      }

      match /messages/{messageId} {
        // Room members may read the discussion chat.
        allow read: if isSignedIn() && isRoomMember(roomId);
        // Messages are immutable, sender-verifiable text under the length cap.
        allow create: if isSignedIn() && isRoomMember(roomId)
          && request.resource.data.player_id == request.auth.uid
          && request.resource.data.type == 'text'
          && request.resource.data.message is string
          && request.resource.data.message.size() >= 1
          && request.resource.data.message.size() <= 200;
        allow update: if false;
        // Only the host may wipe the chat when a new round starts.
        allow delete: if isSignedIn() && isRoomMember(roomId) && isHost(roomId);
      }

      match /rounds/{roundId} {
        allow read: if isSignedIn() && isRoomMember(roomId);
        allow create: if isSignedIn() && isRoomMember(roomId) && isHost(roomId);
        allow update: if isSignedIn() && isRoomMember(roomId) && isHost(roomId);
        allow delete: if isSignedIn() && isRoomMember(roomId) && isHost(roomId);

        match /player_states/{playerId} {
          // A player's role and secret word are private: only the host (the
          // game master) and the player themselves may read their own state.
          allow read: if isSignedIn() && isRoomMember(roomId)
            && (request.auth.uid == playerId || isHost(roomId));
          allow write: if isSignedIn() && isRoomMember(roomId)
            && (isHost(roomId) || isOwnStateUpdate(playerId));
        }

        match /votes/{voterId} {
          allow read: if isSignedIn() && isRoomMember(roomId)
            && (isHost(roomId) || !anonymousVoting(roomId));
          allow create, update: if isSignedIn() && isRoomMember(roomId)
            && request.auth.uid == voterId;
          allow delete: if false;
        }

        match /vote_totals/{targetPlayerId} {
          allow read: if isSignedIn() && isRoomMember(roomId);
          allow create, update, delete: if isSignedIn()
            && isRoomMember(roomId) && isHost(roomId);
        }
      }
    }
  }
}
